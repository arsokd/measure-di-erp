rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function signedIn() { return request.auth != null; }

    function myUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function myRole() { return signedIn() ? myUserData().role : null; }
    function myEmployeeId() { return signedIn() ? myUserData().employeeId : null; }

    function isLeadershipOrAdmin() {
      return signedIn() && myRole() in ['super_admin', 'admin'];
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'super_admin';
    }

    // ---- Named approval authorities (assigned per-person on the Employees
    // page, not tied to a fixed name — see employees.html "Approval Authority") ----
    function isPrimaryApprover() {
      return signedIn() && myUserData().isPrimaryApprover == true;
    }

    function isRatifyingDirector() {
      return signedIn() && myUserData().isDirector == true;
    }

    function isFinanceHead() {
      return signedIn() && myUserData().isFinanceHead == true;
    }

    // Final Approver — gives the same non-blocking final sign-off on
    // quotations/orders/invoices as the Director Ratifier, for anyone else
    // who should also hold that role (e.g. Murugan alongside the Director,
    // per the 3-senior-first-approver / either-Murugan-or-Director-final
    // approval model).
    function isFinalApprover() {
      return signedIn() && myUserData().isFinalApprover == true;
    }

    // Master Data (Master Data Hub — Products, Client Equipment, Bank
    // Details, Clients, Projects, and every dropdown list it manages) is
    // restricted to Super Admin / Admin roles only, by explicit business
    // decision — nobody else in the organization, including a manager or
    // staff member individually flagged for it, or a Director not
    // otherwise holding one of these two roles.
    function isMasterDataAdmin() {
      return isLeadershipOrAdmin();
    }

    // True if the caller owns this record (matches on employeeId) or is admin/leadership.
    // Governs UPDATE only below - by explicit decision, DELETE on every one
    // of these collections is Super Admin / Admin only, full stop, even for
    // a record's own creator. See the dedicated `allow delete` line next to
    // each match block below.
    function isOwnerOrAdmin() {
      return isLeadershipOrAdmin() ||
        (signedIn() && 'employeeId' in resource.data && resource.data.employeeId == myEmployeeId());
    }

    function canCreateOwnRecord() {
      return isLeadershipOrAdmin() ||
        (signedIn() && 'employeeId' in request.resource.data && request.resource.data.employeeId == myEmployeeId());
    }

    // Leads-only: same as isOwnerOrAdmin(), plus whoever the lead's owner
    // (or an admin) has explicitly assigned to handle its follow-up and
    // processing (assignedToEmployeeId) - e.g. the lead originator hands
    // day-to-day work to a colleague without sharing login credentials.
    // Scoped to leads specifically rather than folded into isOwnerOrAdmin()
    // itself, so the other 18 collections sharing that function are
    // unaffected.
    function isLeadOwnerAssigneeOrAdmin() {
      return isOwnerOrAdmin() ||
        (signedIn() && 'assignedToEmployeeId' in resource.data && resource.data.assignedToEmployeeId == myEmployeeId());
    }

    // ---- Identity ----
    match /employees/{docId} {
      allow read: if signedIn();
      allow write: if isLeadershipOrAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == userId || isLeadershipOrAdmin());
      allow delete: if isLeadershipOrAdmin();
    }

    // Single-active-session enforcement (see login.html / auth-guard.js):
    // one doc per Firebase Auth uid holding that device's current session
    // token. Scoped strictly to the signed-in user's own uid, on both read
    // and write - without this, the broad catch-all at the bottom of this
    // file would let any signed-in user overwrite anyone else's session
    // token and force them logged out, which defeats the whole point of a
    // *security* feature.
    match /activeSessions/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Sensitive HR / financial: admin write, self-or-admin read ----
    match /payroll/{docId} {
      allow read: if isLeadershipOrAdmin() ||
        (signedIn() && 'employeeId' in resource.data && resource.data.employeeId == myEmployeeId());
      allow write: if isLeadershipOrAdmin();
    }

    match /bankDetailsMaster/{docId} {
      // Read stays open to any signed-in user — Invoices needs it to
      // auto-populate company bank details on generated invoices for
      // whoever is raising them, not just Master Data Admins.
      allow read: if signedIn();
      allow write: if isMasterDataAdmin();
    }

    // ---- Audit trail: anyone signed in may create an entry (their own action),
    // nobody but admins may alter or remove history after the fact ----
    match /auditLogs/{docId} {
      allow read: if isLeadershipOrAdmin();
      allow create: if signedIn();
      allow update, delete: if isLeadershipOrAdmin();
    }

    // ---- Owner-or-admin collections: everyday operational records ----
    match /leads/{docId}            { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isLeadOwnerAssigneeOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /orders/{docId}           { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /quotations/{docId}       { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /invoices/{docId}         { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /amcContracts/{docId}     { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /amcQuotations/{docId}    { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /amcOrders/{docId}        { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /amcInvoices/{docId}      { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /serviceTickets/{docId}   { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /serviceLeads/{docId}     { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /attendance/{docId}       { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /dwmActivities/{docId}    { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /expenses/{docId}         { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /expenseSplits/{docId}    { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /arAdjustments/{docId}    { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /pgbgReceivables/{docId}  { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /communicationLogs/{docId}{ allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if isLeadershipOrAdmin(); }
    match /reviews/{docId}          { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    match /payments/{docId}         { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }

    // ---- Diagnostics collections: any signed-in user may create an entry
    // (their own error/report), only admins may read or manage the list,
    // except a support ticket's own author may also read it back. ----
    match /errorLogs/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if isLeadershipOrAdmin();
    }
    match /supportTickets/{docId} {
      allow create: if signedIn();
      allow read: if isLeadershipOrAdmin() ||
        (signedIn() && 'employeeId' in resource.data && resource.data.employeeId == myEmployeeId());
      allow update, delete: if isLeadershipOrAdmin();
    }

    // ---- Reference / master data & targets: everyone reads, only admins write ----
    match /kraTargets/{docId}          { allow read: if signedIn(); allow write: if isLeadershipOrAdmin(); }
    match /aopTargets/{docId}          { allow read: if signedIn(); allow write: if isLeadershipOrAdmin(); }
    match /budgets/{docId}             { allow read: if signedIn(); allow write: if isLeadershipOrAdmin(); }
    match /travelPolicyMaster/{docId}  { allow read: if signedIn(); allow write: if isLeadershipOrAdmin(); }
    match /travelApprovals/{docId}     { allow read: if signedIn(); allow create: if canCreateOwnRecord(); allow update: if isOwnerOrAdmin(); allow delete: if isLeadershipOrAdmin(); }
    // Everyone reads (leads/orders/quotations/tickets/etc all need these
    // for their dropdowns); only a Master Data Admin (or Director) may
    // create, edit, or delete a master record itself.
    match /productsMaster/{docId}      { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /sparePartsMaster/{docId}    { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /clientEquipmentMaster/{docId}{ allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /clientsMaster/{docId}       { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /clients/{docId}             { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /projectsMaster/{docId}      { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /leadSourceMaster/{docId}          { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /industryVerticalMaster/{docId}    { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /projectSectorMaster/{docId}       { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /verticalClassificationMaster/{docId} { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /currencyMaster/{docId}            { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /sparePartCategoryMaster/{docId}   { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /complaintCategoryMaster/{docId}   { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /slaResponseTierMaster/{docId}     { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /amcContractTierMaster/{docId}     { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /pmVisitFrequencyMaster/{docId}    { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /amcInvoicingMilestoneMaster/{docId} { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /amcContractDurationMaster/{docId} { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /companyMaster/{docId}             { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /hsnCodeMaster/{docId}             { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /componentsMaster/{docId}          { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }
    match /productBomLines/{docId}           { allow read: if signedIn(); allow write: if isMasterDataAdmin(); }

    // ---- Deny by default for any collection not explicitly listed above ----
    // Every collection this app's code actually reads or writes (checked
    // directly against every getCollection/saveRecord/addItem/updateItem/
    // window.db.collection call site in the repo) already has its own
    // explicit, properly-scoped rule above - this fallback is not a
    // working-but-loose safety net for real traffic, it's dead code in
    // current practice. Failing closed here (rather than "any signed-in
    // user may do anything") means a genuinely new, not-yet-reviewed
    // collection is simply blocked until it gets its own rule added
    // above, instead of silently inheriting broad access nobody decided
    // on. Add that collection's own `match` block above this one (not
    // here) once its access model is actually decided.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
